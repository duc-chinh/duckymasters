diff -ruN a/content/utils.js b/content/utils.js
--- a/content/utils.js	1970-01-01 00:00:00.000000000 +0000
+++ b/content/utils.js	2026-09-29 22:47:07.209176503 +0000
@@ -0,0 +1,50 @@
+/**
+ * ============================================================================
+ *  DuckyMasters — utils.js
+ * ============================================================================
+ *  Petits utilitaires partagés par les modules de /content (DOM, temporisation).
+ *  À injecter juste après site-config.js.
+ * ============================================================================
+ */
+(function (global) {
+  const Utils = {
+    sleep(ms) {
+      return new Promise((resolve) => setTimeout(resolve, ms));
+    },
+
+    /** querySelector tolérant : renvoie null si le sélecteur est vide ou invalide. */
+    qs(root, selector) {
+      if (!selector) return null;
+      try {
+        return root.querySelector(selector);
+      } catch (e) {
+        return null;
+      }
+    },
+
+    /** querySelectorAll tolérant : renvoie [] si le sélecteur est vide ou invalide. */
+    qsa(root, selector) {
+      if (!selector) return [];
+      try {
+        return Array.from(root.querySelectorAll(selector));
+      } catch (e) {
+        return [];
+      }
+    },
+
+    /** Crée un élément. props : { class, text, ...attributs } ; children : nœuds DOM. */
+    el(tag, props, children) {
+      const node = document.createElement(tag);
+      Object.entries(props || {}).forEach(([k, v]) => {
+        if (k === "class") node.className = v;
+        else if (k === "text") node.textContent = v;
+        else node.setAttribute(k, v);
+      });
+      (children || []).forEach((c) => node.appendChild(c));
+      return node;
+    },
+  };
+
+  global.DuckyMasters = global.DuckyMasters || {};
+  global.DuckyMasters.Utils = Utils;
+})(typeof window !== "undefined" ? window : self);
