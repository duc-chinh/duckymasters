{
  "manifest_version": 3,
  "name": "DuckyMasters",
  "version": "1.0.1",
  "description": "Outils personnels pour WikiMasters.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.wiki-masters.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DuckyMasters",
    "default_popup": "popup.html"
  }
}